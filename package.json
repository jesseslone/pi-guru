{
  "name": "pi-guru",
  "version": "0.2.0",
  "description": "pi-coding-agent extension for learning what your agent does and trusting it as you go: gate on change calls, Explain at four levels, per-turn narration, and an AI judge",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jesseslone/pi-guru.git" },
  "keywords": ["pi-package", "pi", "pi-coding-agent", "extension", "permissions", "explain"],
  "files": ["extensions", "src", "README.md", "LICENSE"],
  "pi": { "extensions": ["./extensions/pi-guru.ts", "./extensions/pi-guru-bench.ts"] },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "bench:fetch-smoke": "node --experimental-strip-types scripts/bench-fetch-smoke.ts"
  },
  "dependencies": {
    "@ast-grep/lang-bash": "0.0.8",
    "@ast-grep/lang-javascript": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/napi": "0.45.3",
    "unbash": "^4.0.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}
